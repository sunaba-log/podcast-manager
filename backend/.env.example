# Database
DATABASE_URL=postgresql+asyncpg://podcast_user:podcast_password@localhost:5432/podcast_cms

# FastAPI
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
FRONTEND_URL=http://localhost:3000

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Cloud Storage (GCS)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_SERVICE_ACCOUNT_JSON=

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://cdn.example.com

# Storage Backend Configuration
# Valid values: "gcs", "r2"
STORAGE_BACKEND=gcs
STORAGE_TIMEOUT_SECONDS=30
# Maximum file size in bytes (default: 5GB)
STORAGE_MAX_FILE_SIZE=5368709120

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@podcast-manager.com
SENDER_NAME=Podcast Manager

# Logging
LOG_LEVEL=INFO
LOGS_DIR=./logs

# Environment
ENVIRONMENT=development
